# syntax=docker/dockerfile:1.7
FROM pytorch/pytorch:2.11.0-cuda12.8-cudnn9-devel

ENV DEBIAN_FRONTEND=noninteractive \
    PATH=/root/.cargo/bin:/root/.local/bin:${PATH} \
    CUDA_HOME=/usr/local/cuda \
    SGLANG_CHECKOUT=/workspace/sglang \
    FLASHINFER_CACHE_DIR=/cache/flashinfer \
    TRITON_CACHE_DIR=/cache/triton \
    UV_SYSTEM_PYTHON=1 \
    UV_BREAK_SYSTEM_PACKAGES=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Keep generic CUDA config packages at 12.8 as well. NVIDIA's mutable apt
# repository otherwise upgrades these to 12.9/13.x during unrelated installs.
RUN apt-get update \
    && apt-get install -y --no-install-recommends --allow-downgrades \
        cuda-toolkit-12-config-common=12.8.90-1 \
        cuda-toolkit-config-common=12.8.90-1 \
    && apt-mark hold cuda-toolkit-12-config-common cuda-toolkit-config-common \
    && apt-get install -y --no-install-recommends \
        build-essential ca-certificates cmake curl git libprotobuf-dev \
        ninja-build protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && curl --proto '=https' --tlsv1.2 --retry 3 --retry-delay 2 -sSf \
        https://sh.rustup.rs | sh -s -- -y --no-modify-path --profile minimal

COPY . /opt/sglang-candidate
WORKDIR /opt/sglang-candidate

# CUDA 12.9 Python API bindings are required by torch 2.11+cu128. They do not
# ship nvcc, libcudart, or native CUDA libraries.
RUN uv pip install --python /usr/bin/python --no-cache \
        cuda-python==12.9.4 cuda-bindings==12.9.4 \
    && python - <<'PY' >/tmp/sglang-runtime.txt
import tomllib
from pathlib import Path

data = tomllib.loads(Path("python/pyproject_other.toml").read_text())
for requirement in data["project"]["optional-dependencies"]["runtime_common"]:
    if not requirement.startswith("torchao"):
        print(requirement)
PY
RUN uv pip install --python /usr/bin/python --no-cache \
        -r /tmp/sglang-runtime.txt \
    && uv pip install --python /usr/bin/python --no-cache --no-deps \
        torchao==0.17.0 \
        flashinfer-python==0.6.14 \
    && uv pip install --python /usr/bin/python --no-cache --no-deps \
        --index-url https://flashinfer.ai/whl \
        flashinfer-cubin==0.6.14 \
    && uv pip install --python /usr/bin/python --no-cache --no-deps \
        --index-url https://flashinfer.ai/whl/cu128 \
        flashinfer-jit-cache==0.6.14 \
    && uv pip install --python /usr/bin/python --no-cache \
        cuda-tile==1.4.0 \
        nvidia-cudnn-frontend==1.13.0 \
        nvidia-cutlass-dsl==4.5.2 \
        nvidia-ml-py==12.575.51 \
        pytest pytest-asyncio scikit-build-core setuptools \
        setuptools-rust setuptools-scm wheel

# SGLang does not publish a cu128 wheel for kernel 0.4.4. This official cu129
# wheel contains native sm90/sm120a cubins, no PTX, and links CUDA 12.x SONAMEs.
# Install it without dependencies so the image keeps the cu128 runtime stack.
ARG SGL_KERNEL_WHEEL_SHA256=4ea2f7176965c3d1a5697254befe45c2ac995793577108129710d0f66ca85b33
RUN curl -fL --retry 3 \
        -o /tmp/sglang_kernel-0.4.4+cu129-cp310-abi3-manylinux2014_x86_64.whl \
        https://github.com/sgl-project/whl/releases/download/v0.4.4/sglang_kernel-0.4.4+cu129-cp310-abi3-manylinux2014_x86_64.whl \
    && echo "${SGL_KERNEL_WHEEL_SHA256}  /tmp/sglang_kernel-0.4.4+cu129-cp310-abi3-manylinux2014_x86_64.whl" \
        | sha256sum -c - \
    && uv pip install --python /usr/bin/python --no-cache --no-deps \
        /tmp/sglang_kernel-0.4.4+cu129-cp310-abi3-manylinux2014_x86_64.whl \
    && rm -f /tmp/sglang_kernel-0.4.4+cu129-cp310-abi3-manylinux2014_x86_64.whl

# Install the candidate once so the image is immediately usable. Runtime
# bootstrap performs the same quick Rust-only editable build after cloning.
RUN CARGO_TARGET_DIR=/tmp/sglang-cargo-target \
    python -m pip install --no-cache-dir --no-deps --no-build-isolation \
        -e ./python \
    && rm -rf /tmp/sglang-cargo-target

# FlashInfer's Python package is CUDA-neutral; its dedicated sink kernels JIT
# against nvcc 12.8 on the target architecture.
RUN python scripts/attention_sink/check_cuda_128.py \
    && python - <<'PY'
import importlib.metadata as md
import flashinfer
from sglang.srt.layers.attention.flashinfer_backend import (
    _run_flashinfer_paged_with_sinks,
)

assert md.version("flashinfer-python") == "0.6.14"
assert hasattr(flashinfer, "BatchAttentionWithAttentionSinkWrapper")
assert _run_flashinfer_paged_with_sinks
PY

COPY --chmod=755 scripts/attention_sink/bootstrap_checkout.sh \
    /usr/local/bin/sglang-sink-bootstrap
COPY --chmod=755 scripts/attention_sink/run_all_tests.sh \
    /usr/local/bin/sglang-sink-tests
COPY --chmod=755 scripts/attention_sink/check_cuda_128.py \
    /usr/local/bin/sglang-sink-check-cuda

RUN mkdir -p /workspace /cache/flashinfer /cache/triton \
    && chmod -R 777 /cache

WORKDIR /workspace
CMD ["/bin/bash"]
